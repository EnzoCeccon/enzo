      light: '#3373a5',
      dark: '#003366',
    },
    secondary: {
      main: '#1b8b4c', // Verde institucional
      light: '#43a86e',
      dark: '#116133',
    },
    background: {
      default: '#f5f5f5',
      paper: '#ffffff',
    },
  },
  typography: {
    h4: {
      fontWeight: 600,
    },
    h6: {
      fontWeight: 500,
      color: '#004a8d',
    },
  },
});

function App() {
  return (
    <ThemeProvider theme={theme}>
